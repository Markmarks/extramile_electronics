{
  "name": "extramile",
  "private": true,
  "version": "0.0.0",
  "description": "ExtraMile Electronics — storefront (web) + back-office (Tauri desktop) monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev": "pnpm --filter @extramile/web dev",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --grep-invert @backend",
    "verify:preflight": "node scripts/verify-preflight.mjs",
    "security": "node scripts/security-guard.mjs && node --test scripts/security-guard.test.mjs",
    "security:audit": "pnpm audit --audit-level=high && cd apps/desktop/src-tauri && cargo audit",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "supabase": "^2.110.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,css,yaml,yml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "sharp@<0.35.5": "^0.35.5",
      "brace-expansion@<1.1.20": "^1.1.22",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "vite@>=6.0.0 <6.4.4": "^6.4.6"
    }
  }
}
