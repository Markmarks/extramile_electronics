# ─────────────────────────────────────────────────────────────────────────────
# ExtraMile Electronics — web app environment
# Copy to .env.local and fill in. NEVER commit real values.
# Rule (docs/06 P0 #2): anything NOT prefixed NEXT_PUBLIC_ is server-only and must
# never be imported into a Client Component.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Paystack public key (pk_test_… / pk_live_…) — used to render the inline widget only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# ── Server-only (NEVER prefix NEXT_PUBLIC_, never ship to client/desktop) ────
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Paystack secret key doubles as the webhook HMAC-SHA512 signing secret.
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Transactional email (Resend)
RESEND_API_KEY="re_xxx"
RESEND_FROM="ExtraMile Electronics <orders@store.example.com>"

# Rate limiting (Upstash Redis) — phase P10
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SMS (Hubtel first, swappable) — dispatch/delivery only
SMS_PROVIDER="hubtel"
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
HUBTEL_SENDER_ID="ExtraMile"

# Observability (Sentry) — phase P10
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Build metadata (set by CI/Vercel automatically in prod)
GIT_SHA="dev"

# NOTE: Google/Apple OAuth client secrets live in the Supabase dashboard,
# NOT here (docs/05-OAUTH.md §9).
