# Desktop webview env — ONLY the public Supabase URL + anon key are compiled in.
# service_role and PAYSTACK_SECRET_KEY must NEVER appear here (docs/07 §5, test D-01).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"
# Optional: storefront the back-office asks to refresh its cache after catalogue edits.
# Defaults to https://www.dnvmart.com. Must also be in tauri.conf.json's CSP connect-src.
# VITE_STOREFRONT_URL="https://www.dnvmart.com"
